# ──────────────────────────────────────
# APYGG - Laravel Environment Configuration
# ──────────────────────────────────────
# Copia este archivo a .env y ajusta los valores.
#
# cp .env.example .env
#
# NOTA: Las variables de Docker (puertos, PROJECT, CONTAINER_PREFIX)
# están en compose.env. NO las pongas aquí.
#
# make up [ENV=dev|prod|staging]

# ═══════════════════════════════════════
# LARAVEL APPLICATION
# ═══════════════════════════════════════

APP_NAME=apygg
APP_ENV=dev
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
APP_ADMIN_URL=http://localhost:5173
APP_TIMEZONE=UTC
OCTANE_SERVER=frankenphp

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_ASYNC=false
LOG_STACK=single,sentry_logs
ACTIVITY_LOGGING=true

SECURITY_IP_WHITELIST=
SECURITY_IP_BLACKLIST=
SECURITY_LOG_BLOCKED_ATTEMPTS=true

# ═══════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=apygg
DB_USERNAME=apygg
DB_PASSWORD=secret
DB_POOL=10
DB_TIMEOUT=5

# ═══════════════════════════════════════
# REDIS
# ═══════════════════════════════════════

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

CACHE_STORE=redis
CACHE_TTL_DEFAULT=3600
CACHE_TTL_USER=3600
CACHE_TTL_ENTITY=7200
CACHE_TTL_SEARCH=1800

QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=60
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_HIGH=high
REDIS_QUEUE_DEFAULT=default
REDIS_QUEUE_LOW=low
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

SESSION_DRIVER=redis

# ═══════════════════════════════════════
# BROADCASTING (Reverb)
# ═══════════════════════════════════════

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=apygg
REVERB_APP_KEY=apygg-key-segura
REVERB_APP_SECRET=apygg-secret-seguro
REVERB_HOST=localhost
REVERB_PORT=8012
REVERB_SCHEME=http
REVERB_HOST_INTERNAL=reverb
REVERB_PORT_INTERNAL=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ═══════════════════════════════════════
# SEARCH (Meilisearch / Scout)
# ═══════════════════════════════════════

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=
SCOUT_QUEUE=true
MEILI_ENV=development

# ═══════════════════════════════════════
# FILESYSTEM
# ═══════════════════════════════════════

FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ═══════════════════════════════════════
# AUTHENTICATION (JWT)
# ═══════════════════════════════════════

JWT_TTL=15
JWT_SECRET=
JWT_ALGO=HS256
JWT_REFRESH_TTL=10080
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE=30

# ═══════════════════════════════════════
# SOCIAL AUTH
# ═══════════════════════════════════════

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=${APP_URL}/auth/facebook/callback

# ═══════════════════════════════════════
# ERROR TRACKING (Sentry)
# ═══════════════════════════════════════

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_ENABLE_LOGS=true

# ═══════════════════════════════════════
# DEVELOPMENT TOOLS
# ═══════════════════════════════════════

TELESCOPE_ENABLED=true

# ═══════════════════════════════════════
# CORS
# ═══════════════════════════════════════

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_DEBUG_LOG=false

# ═══════════════════════════════════════
# HASHING
# ═══════════════════════════════════════

HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=5
ARGON_THREADS=3
BCRYPT_ROUNDS=12

# ═══════════════════════════════════════
# HORIZON (Queues)
# ═══════════════════════════════════════

HORIZON_PREFIX=horizon
HORIZON_BALANCE=auto
HORIZON_MAX_PROCESSES=10

# ═══════════════════════════════════════
# BACKUPS
# ═══════════════════════════════════════

BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_DISK=s3
BACKUP_REMOTE_PATH=backups
BACKUP_COMPRESSION_ENABLED=true
BACKUP_COMPRESSION_FORMAT=gzip
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=30
BACKUP_RETENTION_MONTHLY=90
BACKUP_DATABASE_ENABLED=true
BACKUP_FILES_ENABLED=false
BACKUP_NOTIFICATIONS_ENABLED=true
BACKUP_NOTIFY_ON_SUCCESS=false
BACKUP_NOTIFY_ON_FAILURE=true

# ═══════════════════════════════════════
# FRANKENPHP / OCTANE
# ═══════════════════════════════════════

PORT=8000
USE_FRANKENPHP_SSL=false
SERVER_NAME=