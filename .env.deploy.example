# Variables de `make deploy|rollback|smoke` (copia a .env.deploy; NO se versiona). Guía: docs/deploy.md
DEPLOY_HOST=deploy@mi-vps.example.com
DEPLOY_PATH=/srv/miapp
# DEPLOY_PORT=22
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
PROJECT=miapp
IMAGE=ghcr.io/mi-org/mi-repo
# IMAGE_TAG=sha-abc1234          # fija, nunca latest (también por línea de make)
SMOKE_URL=https://api.example.com
# SMOKE_EMAIL=smoke@example.com  # login de prueba opcional (usuario dedicado, sin permisos)
# SMOKE_PASSWORD=
# DEPLOY_AUTO_ROLLBACK=true
# COMPOSE_PROFILES_EXTRA=reverb  # servicios opcionales del compose de producción
