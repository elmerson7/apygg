# ──────────────────────────────────────
# Docker Compose - Variables de Infraestructura
# ──────────────────────────────────────
# Este archivo es para variables Docker ONLY.
# Las variables de Laravel van en .env
#
# Uso: docker compose --env-file compose.env ...
#(make lo hace automáticamente)

# Nombre del proyecto Docker (redes, volúmenes, nombres de contenedores)
# IMPORTANTE: Cambia esto cuando dupliques el proyecto para evitar colisiones
# Ejemplo: PROJECT=poyecto → contenedores: poyecto-app, poyecto-redis, etc.
PROJECT=apygg

# Puertos del host (host:contenedor)
APP_PORT=8010
POSTGRES_PORT=8011
REVERB_PORT=8012
REDIS_PORT=8013
MEILISEARCH_PORT=8014
PGBOUNCER_PORT=8015

# Interfaz donde se publican app, reverb, pgbouncer y meilisearch. Por defecto solo local;
# pon 0.0.0.0 únicamente si necesitas abrirlos a la red (y entonces protégelos con firewall).
# BIND_HOST=127.0.0.1

# Servicios de desarrollo (perfil dev: make up-dev). Solo escuchan en 127.0.0.1.
# Mailpit: SMTP que recibe los correos y su bandeja web.
MAILPIT_SMTP_PORT=8016
MAILPIT_UI_PORT=8017
# Emulador S3 (RustFS): API y consola web.
S3_PORT=8018
S3_CONSOLE_PORT=8019

# Perfil dev de Compose (Mailpit + emulador S3). `make init` escribe DEV=true; en un
# servidor déjalo sin definir. Se puede forzar con: make up DEV=true
# DEV=true

# UID/GID del usuario host (para permisos de archivos)
USER_ID=1000
GROUP_ID=1000

# Database (usadas por docker para crear la DB)
DB_DATABASE=apygg
DB_USERNAME=apygg
DB_PASSWORD=apygg

# Redis password. Valor de ejemplo: `make init` genera uno aleatorio y la app lo rechaza en producción.
REDIS_PASSWORD=RedisSecure2024!
# Imagen publicada en el registry (usada por scripts/prune-images.sh y por los
# scripts de deploy). Formato: <registry>/<owner>/<repo>
# Ejemplo: APP_IMAGE=ghcr.io/miorg/apygg
APP_IMAGE=

# Emulador S3 de desarrollo (perfil dev). Credenciales y buckets: deben coincidir
# con AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_BUCKET / AWS_PRIVATE_BUCKET de .env
S3_ACCESS_KEY=apygg-dev
S3_SECRET_KEY=apygg-dev-secret
S3_BUCKET=apygg
S3_PRIVATE_BUCKET=apygg-private

# Clave maestra de Meilisearch (perfil search). `make init` genera una aleatoria.
# MEILISEARCH_KEY=
