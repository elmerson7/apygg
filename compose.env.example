# ──────────────────────────────────────
# Docker Compose - Variables de Infraestructura
# ──────────────────────────────────────
# Este archivo es para variables Docker ONLY.
# Las variables de Laravel van en .env
#
# Uso: docker compose --env-file compose.env ...
#(make lo hace automáticamente)

# Nombre del proyecto Docker (redes, volúmenes, nombres de contenedores)
# IMPORTANTE: Cambia esto cuando dupliques el proyecto para evitar colisiones
# Ejemplo: PROJECT=poyecto → contenedores: poyecto_app, poyecto_redis, etc.
PROJECT=apygg

# Puertos del host (host:contenedor)
APP_PORT=8010
POSTGRES_PORT=8011
REVERB_PORT=8012
REDIS_PORT=8013
MEILISEARCH_PORT=8014
PGBOUNCER_PORT=8015

# UID/GID del usuario host (para permisos de archivos)
USER_ID=1000
GROUP_ID=1000

# Database (usadas por docker para crear la DB)
DB_DATABASE=apygg
DB_USERNAME=apygg
DB_PASSWORD=apygg

# Redis password
REDIS_PASSWORD=RedisSecure2024!