# ──────────────────────────────────────
# Docker Compose - Variables de Infraestructura
# ──────────────────────────────────────
# Este archivo es para variables Docker ONLY.
# Las variables de Laravel van en .env
#
# Uso: docker compose --env-file compose.env ...
#(make lo hace automáticamente)

# Nombre del proyecto Docker (redes, volúmenes)
PROJECT=APYGG

# Prefijo para nombres de contenedores (único por proyecto/clon)
# IMPORTANTE: Cambia esto cuando dupliques el proyecto para evitar colisiones
CONTAINER_PREFIX=boilerplate

# Puertos del host (host:contenedor)
APP_PORT=8030
POSTGRES_PORT=8031
REVERB_PORT=8032
REDIS_PORT=8033
MEILISEARCH_PORT=8034
PGBOUNCER_PORT=8035

# UID/GID del usuario host (para permisos de archivos)
USER_ID=1000
GROUP_ID=1000