<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         backupGlobals="false"
         backupStaticProperties="false"
         defaultTestSuite="Unit,Feature,Arch">
    <!-- Suite por defecto (`make test`): Unit + Feature + Arch (ver defaultTestSuite).
         Las demás se corren a propósito: make test-contract / test-concurrency / test-e2e.
         Para registrar una suite nueva (p. ej. Integration) basta una línea más aquí. -->
    <testsuites>
        <testsuite name="Unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="Feature"><directory>tests/Feature</directory></testsuite>
        <testsuite name="Arch"><directory>tests/Arch</directory></testsuite>
        <testsuite name="Contract"><directory>tests/Contract</directory></testsuite>
        <testsuite name="Concurrency"><directory>tests/Concurrency</directory></testsuite>
        <testsuite name="E2E"><directory>tests/E2E</directory></testsuite>
        <!-- Contra servicios reales (Mailpit y S3 del perfil dev). Sin
             INTEGRATION_MAIL_URL / INTEGRATION_S3_ENDPOINT sus tests se omiten.
             Se lanza con: make test-integration (ver docs/local-services.md) -->
        <testsuite name="Integration"><directory>tests/Integration</directory></testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>app/Console</directory>
            <directory>app/Exceptions</directory>
            <directory>app/Http/Middleware</directory>
        </exclude>
    </source>
    <php>
        <!-- force="true": el contenedor exporta las variables de .env y sin
             force ganarían ellas (cola en Redis, correo real, APP_ENV=dev...). -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <!-- La BD de tests es <DB_DATABASE>_test; la resuelve Tests\TestCase.
             Ponlo en false para correr contra la BD de la conexión por defecto. -->
        <env name="DB_TEST_ISOLATION" value="true"/>
        <!-- Caché en memoria: Redis persiste entre tests y RefreshDatabase no lo
             revierte, así que un test podría leer datos cacheados por otro. -->
        <env name="CACHE_STORE" force="true" value="array"/>
        <env name="SCOUT_DRIVER" force="true" value="null"/>
        <env name="MAIL_MAILER" force="true" value="array"/>
        <env name="MAIL_BLOCK_RESERVED_DOMAINS" force="true" value="false"/>
        <env name="QUEUE_CONNECTION" force="true" value="sync"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="BACKOFFICE_ENABLED" value="true" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <ini name="memory_limit" value="1G"/>
    </php>
</phpunit>
