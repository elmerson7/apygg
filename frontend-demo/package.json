{
  "name": "apygg-frontend-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cliente de pruebas de APYGG: demuestra la API con tipos generados desde docs/openapi.json. No es un producto.",
  "scripts": {
    "api:types": "openapi-typescript ../docs/openapi.json -o src/api/schema.d.ts",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.14.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "jsdom": "27.0.1",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
