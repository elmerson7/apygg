# ──────────────────────────────────────────────────────────────────────────
# .env de PRODUCCIÓN (plantilla). Cópialo a DEPLOY_PATH/.env en el servidor y rellena TODOS los
# valores vacíos con secretos generados (openssl rand -base64 48). NO se versiona con valores reales.
# Guía: docs/deploy.md. Complemento de .env.example (desarrollo): aquí solo lo que cambia o es obligatorio.
#
# Al arrancar con APP_ENV=production la app se NIEGA a iniciar (ProductionConfigGuard) si encuentra
# APP_DEBUG=true, JWT_SECRET/DB_PASSWORD/REDIS_PASSWORD/MEILISEARCH_KEY vacíos o por defecto
# (`secret`, `masterKey`...) o Sentry al 100 % de muestreo.
# ──────────────────────────────────────────────────────────────────────────

APP_NAME=
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
SCRAMBLE_PUBLIC_DOCS=false
# actívalo solo si usas el back-office (MFA obligatorio)
BACKOFFICE_ENABLED=false
# IP/CIDR de tu proxy TLS delante de la app
TRUSTED_PROXIES=

# Logs: sin ruido ni datos de depuración
LOG_LEVEL=warning
LOG_STACK=daily,sentry_logs

# Base de datos y Redis (instancias propias o gestionadas; contraseñas fuertes y distintas)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=
REDIS_PASSWORD=

# JWT: secreto largo (>= 64 caracteres)
JWT_SECRET=
JWT_ALGO=HS256

# Búsqueda (si usas Meilisearch): clave maestra propia, nunca `masterKey`
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=
MEILISEARCH_KEY=

# Sentry: tasa BAJA (1.0 = 100 % de las peticiones; la validación de arranque lo rechaza)
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.01

# Archivos (S3 real), correo y pagos reales: sin credenciales por defecto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_PRIVATE_BUCKET=
MAIL_MAILER=
MAIL_FROM_ADDRESS=
PAYMENTS_MODE=real
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Herramientas de desarrollo apagadas
TELESCOPE_ENABLED=false
DEVTOOLS_ALLOWED_EMAILS=

# Reverb (solo si usas websockets, perfil reverb): claves propias
BROADCAST_CONNECTION=log
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
