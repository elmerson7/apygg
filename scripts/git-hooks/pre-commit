#!/bin/bash
#
# Pre-commit Hook
# Ejecuta validaciones antes de permitir un commit
#
# Validaciones:
# 1. Sintaxis PHP (php -l)
# 2. Formateo automático con Pint
# 3. Detección de dd(), dump(), console.log, var_dump
# 4. Tests rápidos (opcional, puede deshabilitarse)

set -e

# Colores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Configuración
SKIP_TESTS=${SKIP_TESTS:-false}
# HOOKS_REQUIRE_DOCKER=true: si no hay contenedor, el commit falla en vez de avisar y seguir
HOOKS_REQUIRE_DOCKER=${HOOKS_REQUIRE_DOCKER:-false}

REPO_ROOT=$(git rev-parse --show-toplevel)

# Nombre del proyecto Docker: PROJECT de compose.env (como el Makefile); el contenedor es <PROJECT>-app
PROJECT=${PROJECT:-}
if [ -z "$PROJECT" ] && [ -f "$REPO_ROOT/compose.env" ]; then
    PROJECT=$(grep -m1 '^PROJECT=' "$REPO_ROOT/compose.env" | cut -d= -f2- | tr -d '"' | tr -d "'")
fi
PROJECT=${PROJECT:-apygg}
CONTAINER_NAME="${PROJECT}-app"
DC="docker compose --project-name ${PROJECT} --env-file ${REPO_ROOT}/compose.env"

# Sin Docker o sin contenedor no se puede validar: se AVISA claramente (y se bloquea solo con HOOKS_REQUIRE_DOCKER=true)
skip_validations() {
    echo -e "${YELLOW}⚠️  $1${NC}"
    echo -e "${YELLOW}   ESTE COMMIT NO SE HA VALIDADO (sintaxis, debug, Pint, tests).${NC}"
    if [ "$HOOKS_REQUIRE_DOCKER" = "true" ]; then
        echo -e "${RED}❌ HOOKS_REQUIRE_DOCKER=true: commit bloqueado.${NC}"
        exit 1
    fi
    exit 0
}

# Verificar si Docker está corriendo
if ! docker ps >/dev/null 2>&1; then
    skip_validations "Docker no está disponible."
fi

# Verificar si el contenedor está corriendo
if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    echo -e "${YELLOW}   Ejecuta: make up${NC}"
    skip_validations "El contenedor ${CONTAINER_NAME} no está corriendo."
fi

# Obtener archivos PHP staged
STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(php)$' || true)

# Si no hay archivos PHP staged, salir
if [ -z "$STAGED_PHP_FILES" ]; then
    echo -e "${GREEN}✓ No hay archivos PHP para validar${NC}"
    exit 0
fi

echo -e "${GREEN}🔍 Ejecutando validaciones de pre-commit...${NC}"
echo ""

# Contador de errores
ERRORS=0

# 1. Validar sintaxis PHP
echo -e "${GREEN}[1/4] Validando sintaxis PHP...${NC}"
for FILE in $STAGED_PHP_FILES; do
    if [ -f "$FILE" ]; then
        if ! ${DC} exec -T app php -l "$FILE" >/dev/null 2>&1; then
            echo -e "${RED}✗ Error de sintaxis en: $FILE${NC}"
            ${DC} exec -T app php -l "$FILE" 2>&1 | head -5
            ERRORS=$((ERRORS + 1))
        fi
    fi
done

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}❌ Errores de sintaxis encontrados. Corrige los errores antes de hacer commit.${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Sintaxis PHP válida${NC}"
echo ""

# 2. Detectar código de debug (dd, dump, console.log, var_dump)
echo -e "${GREEN}[2/4] Buscando código de debug...${NC}"
DEBUG_PATTERNS=(
    '\bdd\s*\('
    '\bdump\s*\('
    '\bvar_dump\s*\('
    'console\.log\s*\('
)

FOUND_DEBUG=false
for FILE in $STAGED_PHP_FILES; do
    if [ -f "$FILE" ]; then
        for PATTERN in "${DEBUG_PATTERNS[@]}"; do
            if grep -nE "$PATTERN" "$FILE" >/dev/null 2>&1; then
                if [ "$FOUND_DEBUG" = false ]; then
                    echo -e "${RED}✗ Se encontró código de debug en los archivos staged:${NC}"
                    FOUND_DEBUG=true
                fi
                echo -e "${RED}  - $FILE${NC}"
                grep -nE "$PATTERN" "$FILE" | sed 's/^/    /' || true
                ERRORS=$((ERRORS + 1))
            fi
        done
    fi
done

if [ "$FOUND_DEBUG" = true ]; then
    echo ""
    echo -e "${RED}❌ Por favor, elimina el código de debug (dd, dump, var_dump, console.log) antes de hacer commit.${NC}"
    echo -e "${YELLOW}   Si necesitas hacer commit con debug, usa: git commit --no-verify${NC}"
    exit 1
fi
echo -e "${GREEN}✓ No se encontró código de debug${NC}"
echo ""

# 3. Formatear código con Pint automáticamente
echo -e "${GREEN}[3/4] Formateando código con Pint...${NC}"
PINT_FILES=$(echo "$STAGED_PHP_FILES" | tr '\n' ' ')
if [ -n "$PINT_FILES" ]; then
    # Ejecutar Pint solo en archivos staged
    if ${DC} exec -T app ./vendor/bin/pint $PINT_FILES >/dev/null 2>&1; then
        # Si Pint modificó archivos, agregarlos al staging
        MODIFIED_FILES=$(git diff --name-only | grep -E '\.(php)$' || true)
        if [ -n "$MODIFIED_FILES" ]; then
            echo -e "${YELLOW}⚠️  Pint formateó algunos archivos. Agregándolos al staging...${NC}"
            echo "$MODIFIED_FILES" | xargs git add 2>/dev/null || true
        fi
        echo -e "${GREEN}✓ Código formateado${NC}"
    else
        echo -e "${YELLOW}⚠️  Pint encontró problemas de formato. Revisa los archivos.${NC}"
        echo -e "${YELLOW}   Ejecuta: make pint${NC}"
    fi
fi
echo ""

# 4. Ejecutar tests (opcional, puede ser lento)
if [ "$SKIP_TESTS" != "true" ]; then
    echo -e "${GREEN}[4/4] Ejecutando tests rápidos...${NC}"
    echo -e "${YELLOW}   (Puedes saltar tests con: SKIP_TESTS=true git commit)${NC}"
    
    # Ejecutar solo tests relacionados con archivos modificados si es posible
    # Por ahora ejecutamos todos los tests, pero puede optimizarse
    if ${DC} exec -T app composer test >/dev/null 2>&1; then
        echo -e "${GREEN}✓ Tests pasaron${NC}"
    else
        echo -e "${RED}✗ Tests fallaron${NC}"
        echo -e "${YELLOW}   Ejecuta manualmente: make test${NC}"
        echo -e "${YELLOW}   O salta tests: SKIP_TESTS=true git commit${NC}"
        ERRORS=$((ERRORS + 1))
    fi
else
    echo -e "${YELLOW}[4/4] Tests saltados (SKIP_TESTS=true)${NC}"
fi

echo ""

# Resumen
if [ $ERRORS -eq 0 ]; then
    echo -e "${GREEN}✅ Todas las validaciones pasaron. Procediendo con el commit...${NC}"
    exit 0
else
    echo -e "${RED}❌ Se encontraron $ERRORS error(es). Corrige los problemas antes de hacer commit.${NC}"
    echo -e "${YELLOW}   Para saltar validaciones (no recomendado): git commit --no-verify${NC}"
    exit 1
fi
